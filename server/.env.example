# Copy to .env and fill in real values. Never commit .env.

# HTTP
PORT=8787
HOST=0.0.0.0

# OpenRouter (used for function-calling action parsing).
# Get a key at https://openrouter.ai/keys; pick any model it proxies
# (e.g. openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Notion (used for list-item execution)
NOTION_INTEGRATION_TOKEN=
# JSON mapping of spoken list name -> Notion database id.
# Example: {"shopping":"3f9c1d2e...","general":"a1b2c3d4..."}
NOTION_DATABASES={}
NOTION_API_BASE=https://api.notion.com/v1

# Google Calendar (used for calendar-event execution).
# Option A: service account. Create one in Google Cloud, share the target
# calendar with the service account email (Settings -> Share with specific
# people), and set:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Either a base64-encoded private key (GOOGLE_SERVICE_ACCOUNT_KEY) or a path
# to the PEM file (GOOGLE_SERVICE_ACCOUNT_KEY_FILE).
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Calendar id to write to; "primary" works for the account the service
# account impersonates or the calendar it was shared with.
GOOGLE_CALENDAR_ID=primary

# Option B: OAuth refresh token (single-user dev flows).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Subscription: which registered users are Pro (comma-separated emails).
# A RevenueCat webhook can replace this at /api/v1/webhooks/revenuecat.
PRO_USER_EMAILS=