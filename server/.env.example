# Copy to .env and fill in real values. Never commit .env.

# HTTP
PORT=8787
HOST=0.0.0.0

# OpenRouter (used for function-calling action parsing).
# Get a key at https://openrouter.ai/keys; pick any model it proxies
# (e.g. openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage (used for list items and calendar events).
# JSON file path on the server where items/events are persisted.
STORAGE_PATH=./data/items.json

# Google Calendar integration (live execution with dual-mode storage fallback)
GOOGLE_CALENDAR_ID=primary
# Service account auth (recommended for server-to-server)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# OAuth alternative:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Explicit toggle override:
# GOOGLE_CALENDAR_ENABLED=false

# Notion integration (live execution with dual-mode storage fallback)
NOTION_INTEGRATION_TOKEN=
NOTION_DATABASES={"shopping":"<database_id>","general":"<database_id>"}
# Explicit toggle override:
# NOTION_ENABLED=false

# SQLite-free JSON store for users/sessions/quota (auto-created).
# DB_FILE=./data/db.json

# Subscription: which registered users are Pro (comma-separated emails).
# A RevenueCat webhook can replace this at /api/v1/webhooks/revenuecat.
PRO_USER_EMAILS=

# Shared secret for RevenueCat webhook authenticity (leave empty to skip
# signature checks in development).
# REVENUECAT_WEBHOOK_SECRET=

# Rate-limit overrides (per IP). Defaults: 300 global/min, 5 auth/hour,
# 30 parse/hour, 120 execute/hour, 60 webhook/min.
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_PARSE_MAX=30
# RATE_LIMIT_EXECUTE_MAX=120
# RATE_LIMIT_WEBHOOK_MAX=60