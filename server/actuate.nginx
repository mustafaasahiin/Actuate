server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 35.232.148.87.sslip.io _;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    listen 8787 ssl default_server;
    listen [::]:8787 ssl default_server;
    server_name 35.232.148.87.sslip.io _;

    ssl_certificate /etc/letsencrypt/live/35.232.148.87.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/35.232.148.87.sslip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    error_page 497 https://35.232.148.87.sslip.io:8787$request_uri;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
